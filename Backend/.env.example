# Copia este archivo como ".env" y llena tus propios valores.
# NUNCA subas el archivo ".env" real a GitHub.
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=********
SUPABASE_SERVICE_KEY=********

# Sesión (JWT). Genera uno largo y aleatorio.
JWT_SECRET=********
JWT_EXPIRA=7d

# Correo (SMTP). Con Gmail usa una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=tu_correo@gmail.com
SMTP_CONTRASENA=********

# Correo por API (necesario en Render gratis, que bloquea SMTP). Si se llena
# BREVO_API_KEY, se usa en lugar de SMTP. CORREO_REMITENTE debe ser un
# remitente verificado en Brevo.
BREVO_API_KEY=
CORREO_REMITENTE=

# Dirección del frontend (en producción, la URL de Vercel). Se usa en CORS
# y en los enlaces de los correos.
FRONTEND_URL=http://localhost:5173
# Otros orígenes permitidos, separados por coma (opcional)
CORS_ORIGENES=

# Cloudinary
CLOUDINARY_CLOUD_NAME=********
CLOUDINARY_API_KEY=********
CLOUDINARY_API_SECRET=********
